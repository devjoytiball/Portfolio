<!-- ================= RESUME SECTION ================= -->

<section class="resume-section">

    <div class="container">


        <!-- TITLE -->

        <div class="text-center mb-5">

            <h1 class="section-heading">
                My Resume
            </h1>

            <p class="section-subtitle">
                Download my resume to know more about me
            </p>

        </div>


        <!-- RESUME CARD -->

        <div class="resume-card">


            <!-- RESUME ICON -->

            <div class="resume-icon">

                <i class="fa-solid fa-file-pdf"></i>

            </div>


            <h2>
                Devjoyti Ball
            </h2>


            <p class="resume-description">

                Frontend Developer | Computer Science & Engineering Student

            </p>


            <!-- RESUME PREVIEW -->

           <div class="resume-preview">

    <img
        src="/resume/Devjoyti.jpg"
        alt="Devjoyti Ball Resume"
        class="resume-preview-image"
    >

</div>


            <!-- BUTTONS -->

            <div class="resume-buttons">


                <!-- VIEW -->

                <a
                    href="/resume/Devjoyti-Ball-Resume.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                >

                    <i class="fa-solid fa-eye"></i>

                    View Resume

                </a>


                <!-- DOWNLOAD -->

                <a
                    href="/resume/Devjoyti-Ball-Resume.pdf"
                    download="Devjoyti-Ball-Resume.pdf"
                    class="btn btn-dark"
                >

                    <i class="fa-solid fa-download"></i>

                    Download Resume

                </a>


            </div>

