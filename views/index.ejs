<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="Devjoyti Ball - Frontend Developer Portfolio"
    >

    <title>Devjoyti Ball | Portfolio</title>

    <!-- Bootstrap CSS -->
