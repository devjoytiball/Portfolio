        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                Devjoyti Ball
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div
                class="collapse navbar-collapse"
                id="navbarNav"
            >

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link active" href="/">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/projects">
                            Projects
                        </a>
                    </li>

                    <li class="nav-item">
    <a class="nav-link" href="#skills">
        Skills
    </a>
</li>

                    <li class="nav-item">
                        <a class="nav-link" href="/certificates">
                            Certificates
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/resume">
                              <i class="fa-solid fa-file-pdf me-1"></i>
                            Resume
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">
                            Contact
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- ================= HOME SECTION ================= -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center min-vh-100">

            <!-- LEFT SIDE -->

            <div class="col-lg-7 col-md-7">

                
                <!-- Typing Animation -->

                <h1 class="hero-title">
                    <span id="typing-text"></span>
                    <span class="typing-cursor">|</span>
                </h1>

                <h2 class="hero-subtitle">
                    Frontend Developer
                </h2>

                <p class="hero-description">

                    I am a Computer Science and Engineering student
                    passionate about creating responsive, modern and
                    user-friendly websites and web applications.

                </p>
                    <!-- BUTTONS -->

                    <div class="hero-buttons">

                        <a
                            href="/projects"
                            class="btn btn-primary btn-lg me-2"
                        >
                            <i class="fa-solid fa-code"></i>
                            View Projects
                        </a>
<a href="/resume"
   target="_blank"
   class="btn btn-primary btn-lg">

    <i class="fa-solid fa-file-pdf me-2"></i>

    View Resume

</a>

<a href="/resume"
   download
   class="btn btn-outline-dark btn-lg">

    <i class="fa-solid fa-download me-2"></i>

    Download Resume

</a>
                        <a
                            href="/about"
                            class="btn btn-outline-light btn-lg"
                        >
                            About Me
                        </a>

                    </div>


                    <!-- SOCIAL LINKS -->

                    <div class="social-links mt-4">

                        <a
                            href=" http://www.linkedin.com/in/devjoyti-ball-71a228291"
                            target="_blank"
                            aria-label="LinkedIn"
                            rel="noopener noreferrer"
                        >
                            <i class="fa-brands fa-linkedin"></i>
                        </a>

                        <a
                            href="mailto:devjoytiball.24@gmail.com"
                            aria-label="Email"
                        >
                            <i class="fa-solid fa-envelope"></i>
                        </a>

                    </div>

                </div>


                <!-- RIGHT SIDE -->

                <div class="col-lg-5 col-md-5 text-center">

                    <div class="profile-container">

                        <img
                            src="/images/profile.jpg"
                            alt="Devjoyti Ball"
                            class="profile-image"
                        >

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= QUICK INTRO ================= -->

    <section class="intro-section py-5">

        <div class="container text-center">

            <h2 class="section-title">
                I am Devjoyti Welcome to My Portfolio
            </h2>

            <p class="section-text">

                Explore my skills, projects, certificates and
                professional experience. You can also contact me
                through the contact section.

            </p>

            <a
                href="/resume"
                class="btn btn-dark mt-3"
            >
                <i class="fa-solid fa-file-pdf"></i>
                View My Resume
            </a>

        </div>

    </section>

    <!-- ================= SKILLS SECTION ================= -->

<section id="skills" class="skills-section py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">
                My Skills
            </h2>

            <p class="section-text">
                Technologies and tools I work with
            </p>

        </div>


        <div class="row g-4 justify-content-center">


            <!-- HTML -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-html5 skill-icon"></i>

                    <h5>
                        HTML
                    </h5>

                    <p>
                        Web Structure
                    </p>

                </div>

            </div>


            <!-- CSS -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-css3-alt skill-icon"></i>

                    <h5>
                        CSS
                    </h5>

                    <p>
                        Web Styling
                    </p>

                </div>

            </div>


            <!-- JavaScript -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-js skill-icon"></i>

                    <h5>
                        JavaScript
                    </h5>

                    <p>
                        Web Programming
                    </p>

                </div>

            </div>


            <!-- C -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-solid fa-c skill-icon"></i>

                    <h5>
                        C
                    </h5>

                    <p>
                        Programming
                    </p>

                </div>

            </div>


            <!-- Python -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-python skill-icon"></i>

                    <h5>
                        Python
                    </h5>

                    <p>
                        Programming
                    </p>

                </div>

            </div>


            <!-- Node.js -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-node-js skill-icon"></i>

                    <h5>
                        Node.js
                    </h5>

                    <p>
                        Backend Development
                    </p>

                </div>

            </div>


            <!-- MySQL -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-solid fa-database skill-icon"></i>

                    <h5>
                        MySQL
                    </h5>

                    <p>
                        Database
                    </p>

                </div>

            </div>


            <!-- Bootstrap -->

            <div class="col-6 col-md-4 col-lg-3">

                <div class="skill-card">

                    <i class="fa-brands fa-bootstrap skill-icon"></i>

                    <h5>
                        Bootstrap
                    </h5>

                    <p>
                        Responsive Design
                    </p>

                </div>

            </div>


        </div>

    </div>

</section>

<!-- ================= PROJECTS PREVIEW ================= -->

<section class="projects-preview py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">
                My Projects
            </h2>

            <p class="section-text">
                Some of my recent projects
            </p>

        </div>


        <div class="row g-4">


            <% if (projects && projects.length > 0) { %>


                <% projects.forEach(project => { %>


                    <div class="col-md-6 col-lg-4">


                        <div class="card h-100 shadow-sm">


                            <% if (project.image) { %>

                                <a
                                    href="<%= project.live_url || '#' %>"
                                    target="_blank">

                                    <img
                                        src="<%= project.image.startsWith('/') ? project.image : '/images/projects/' + project.image %>"
                                        class="card-img-top"
                                        alt="<%= project.title %>"
                                        style="height:220px; object-fit:cover;">

                                </a>

                            <% } %>


                            <div class="card-body">

                                <h5 class="card-title fw-bold">

                                    <%= project.title %>

                                </h5>


                                <% if (project.description) { %>

                                    <p class="card-text text-muted">

                                        <%= project.description %>

                                    </p>

                                <% } %>


                                <% if (project.technologies) { %>

                                    <p class="small">

                                        <strong>
                                            Technologies:
                                        </strong>

                                        <%= project.technologies %>

                                    </p>

                                <% } %>


                                <% if (project.live_url) { %>

                                    <a
                                        href="<%= project.live_url %>"
                                        target="_blank"
                                        class="btn btn-primary">

                                        <i class="fa-solid fa-globe me-1"></i>

                                        Visit Project

                                    </a>

                                <% } %>


                            </div>

                        </div>


                    </div>


                <% }) %>


            <% } else { %>


                <div class="col-12">

                    <div class="alert alert-info text-center">

                        No projects available.

                    </div>

                </div>


            <% } %>


        </div>


        <div class="text-center mt-4">

            <a
                href="/projects"
                class="btn btn-outline-primary">

                View All Projects

            </a>

        </div>

    </div>

</section>

<!-- ================= CERTIFICATES PREVIEW ================= -->

<section class="certificates-preview py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">
                My Certificates
            </h2>

            <p class="section-text">
                My achievements and certifications
            </p>

        </div>


        <div class="row g-4">


            <% if (certificates && certificates.length > 0) { %>


                <% certificates.forEach(certificate => { %>


                    <div class="col-md-6 col-lg-4">


                        <div class="card h-100 shadow-sm">


                            <% if (certificate.certificate_file) { %>

                                <img
                                    src="/certificates/<%= certificate.certificate_file %>"
                                    class="card-img-top"
                                    alt="<%= certificate.title %>"
                                    style="height:220px; object-fit:cover;">

                            <% } %>


                            <div class="card-body">

                                <h5 class="card-title fw-bold">

                                    <%= certificate.title %>

                                </h5>


                                <% if (certificate.issuer) { %>

                                    <p class="text-muted">

                                        <i class="fa-solid fa-building me-1"></i>

                                        <%= certificate.issuer %>

                                    </p>

                                <% } %>


                                <% if (certificate.issue_date) { %>

                                    <p class="small">

                                        <i class="fa-regular fa-calendar me-1"></i>

                                        <%= certificate.issue_date %>

                                    </p>

                                <% } %>


                                <% if (certificate.certificate_url) { %>

                                    <a
                                        href="<%= certificate.certificate_url %>"
                                        target="_blank"
                                        class="btn btn-primary">

                                        <i class="fa-solid fa-eye me-1"></i>

                                        View Certificate

                                    </a>

                                <% } %>


                            </div>

                        </div>


                    </div>


                <% }) %>


            <% } else { %>


                <div class="col-12">

                    <div class="alert alert-info text-center">

                        No certificates available.

                    </div>

                </div>


            <% } %>


        </div>


        <div class="text-center mt-4">

            <a
                href="/certificates"
                class="btn btn-outline-primary">

                View All Certificates

            </a>

        </div>

    </div>

</section>

    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="container text-center">

            <p class="mb-0">
                © 2026 Devjoyti Ball. All Rights Reserved.
            </p>

        </div>

    </footer>


    <!-- Bootstrap JavaScript -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- Custom JavaScript -->

    <script src="/js/script.js"></script>

</body>

</html>