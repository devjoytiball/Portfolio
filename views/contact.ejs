        <a
            class="navbar-brand fw-bold"
            href="/"
        >
            Devjoyti Ball
        </a>


        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >

            <span class="navbar-toggler-icon"></span>

        </button>


        <div
            class="collapse navbar-collapse"
            id="navbarNav"
        >

            <ul class="navbar-nav ms-auto">


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/"
                    >
                        Home
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/about"
                    >
                        About
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/projects"
                    >
                        Projects
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/certificates"
                    >
                        Certificates
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
