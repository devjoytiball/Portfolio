<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Devjoyti Ball - Certificates"
    >

    <title>Certificates | Devjoyti Ball</title>


    <!-- Bootstrap CSS -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- Custom CSS -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-lg navbar-dark fixed-top custom-navbar">

    <div class="container">

        <a
            class="navbar-brand fw-bold"
            href="/"
        >
            Devjoyti Ball
        </a>


        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
        >

            <span class="navbar-toggler-icon"></span>

        </button>


        <div
            class="collapse navbar-collapse"
            id="navbarNav"
        >

            <ul class="navbar-nav ms-auto">

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/"
                    >
                        Home
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/about"
                    >
                        About
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/projects"
                    >
                        Projects
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link active"
                        href="/certificates"
                    >
                        Certificates
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/resume"
                    >
                        Resume
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/contact"
                    >
                        Contact
                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>


<!-- ================= CERTIFICATES ================= -->

<section class="certificates-section">

    <div class="container">


        <!-- PAGE TITLE -->

        <div class="text-center mb-5">

            <h1 class="section-heading">
                My Certificates
            </h1>

            <p class="section-subtitle">
                Certificates and achievements I have earned
            </p>

        </div>


        <!-- CERTIFICATE CARDS -->

        <div class="row g-4">


            <% if (certificates.length === 0) { %>

                <div class="col-12 text-center">

                    <div class="alert alert-info">

                        No certificates available yet.

                    </div>

                </div>

            <% } %>


            <% certificates.forEach(certificate => { %>


                <div class="col-lg-4 col-md-6">


                    <div class="certificate-card">


                        <!-- CERTIFICATE IMAGE -->

                        <div class="certificate-image-container">

                            <% if (certificate.certificate_file) { %>

                                <a
                                    href="/certificates/<%= certificate.certificate_file %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    title="View Certificate"
                                >

                                    <img
                                        src="/certificates/<%= certificate.certificate_file %>"
                                        alt="<%= certificate.title %>"
                                        class="certificate-image"
                                    >

                                </a>

                            <% } else { %>

                                <div class="certificate-placeholder">

                                    <i
                                        class="fa-solid fa-certificate"
                                    ></i>

                                </div>

                            <% } %>

                        </div>


                        <!-- CERTIFICATE INFORMATION -->

                        <div class="certificate-content">


                            <h3 class="certificate-title">

                                <%= certificate.title %>

                            </h3>


                            <p class="certificate-organization">

                                <i
                                    class="fa-solid fa-building"
                                ></i>

                                <%= certificate.organization %>

                            </p>


                            <% if (certificate.issue_date) { %>

                                <p class="certificate-date">

                                    <i
                                        class="fa-solid fa-calendar"
                                    ></i>

                                    <%= new Date(
                                        certificate.issue_date
                                    ).toLocaleDateString(
                                        'en-IN',
                                        {
                                            day: '2-digit',
                                            month: 'long',
                                            year: 'numeric'
                                        }
                                    ) %>

                                </p>

                            <% } %>


                            <% if (certificate.description) { %>

                                <p class="certificate-description">

                                    <%= certificate.description %>

                                </p>

                            <% } %>


                            <!-- VIEW BUTTON -->

                            <% if (certificate.certificate_file) { %>

                                <a
                                    href="/certificates/<%= certificate.certificate_file %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-primary certificate-button"
                                >

                                    <i
                                        class="fa-solid fa-eye"
                                    ></i>

                                    View Certificate

                                </a>

                            <% } %>


                        </div>

                    </div>

                </div>


            <% }) %>


        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer class="footer">

    <div class="container text-center">

        <p class="mb-0">

            © 2026 Devjoyti Ball. All Rights Reserved.

        </p>

    </div>

</footer>


<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>

</html>