<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Resume Management</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body class="bg-light">

<div class="container-fluid">

    <div class="row">

        <!-- SIDEBAR -->

        <div class="col-md-3 col-lg-2 bg-dark text-white min-vh-100 p-3">

            <h3 class="text-center mb-4">
                Admin Panel
            </h3>

            <hr>

            <ul class="nav flex-column">

                <li class="nav-item mb-2">

                    <a href="/admin/dashboard"
                       class="nav-link text-white">

                        <i class="fa-solid fa-house me-2"></i>
                        Dashboard

                    </a>

                </li>

                <li class="nav-item mb-2">

                    <a href="/admin/projects"
                       class="nav-link text-white">

                        <i class="fa-solid fa-code me-2"></i>
                        Projects

                    </a>

                </li>

                <li class="nav-item mb-2">

                    <a href="/admin/certificates"
                       class="nav-link text-white">

                        <i class="fa-solid fa-certificate me-2"></i>
                        Certificates

                    </a>

                </li>

                <li class="nav-item mb-2">

                    <a href="/admin/resume"
                       class="nav-link active bg-primary rounded">

                        <i class="fa-solid fa-file-pdf me-2"></i>
                        Resume

                    </a>

                </li>

            </ul>

            <hr>

            <a href="/admin/logout"
               class="btn btn-danger w-100">

                <i class="fa-solid fa-right-from-bracket me-2"></i>
                Logout

            </a>

        </div>


        <!-- MAIN CONTENT -->

        <div class="col-md-9 col-lg-10 p-4">

            <h2 class="mb-4">

                <i class="fa-solid fa-file-pdf text-danger"></i>

                Resume Management

            </h2>


            <!-- UPLOAD CARD -->

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-upload me-2"></i>

                        Upload New Resume

                    </h5>

                </div>

                <div class="card-body">

                    <form
                        action="/admin/resume/upload"
                        method="POST"
                        enctype="multipart/form-data">

                        <div class="mb-3">

                            <label class="form-label">

                                Select Resume PDF

                            </label>

                            <input
                                type="file"
                                name="resume"
                                class="form-control"
                                accept=".pdf"
                                required>

                            <small class="text-muted">

                                Only PDF files are allowed.
                                Maximum size: 10 MB.

                            </small>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary">

                            <i class="fa-solid fa-cloud-arrow-up me-2"></i>

                            Upload Resume

                        </button>

                    </form>

                </div>

            </div>


            <!-- CURRENT RESUME -->

            <div class="card shadow-sm">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">

                        <i class="fa-solid fa-file-lines me-2"></i>

                        Current Resume

                    </h5>

                </div>

                <div class="card-body">

                    <% if (resume) { %>

                        <div class="row align-items-center">

                            <div class="col-md-8">

                                <h5>

                                    <i class="fa-solid fa-file-pdf text-danger me-2"></i>

                                    <%= resume.file_name %>

                                </h5>

                                <p class="text-muted">

                                    Uploaded:
                                    <%= new Date(resume.uploaded_at).toLocaleString() %>

                                </p>

                            </div>


                            <div class="col-md-4 text-md-end">

                                <a
                                    href="/uploads/resume/<%= resume.file_name %>"
                                    target="_blank"
                                    class="btn btn-success mb-2">

                                    <i class="fa-solid fa-eye me-1"></i>

                                    View

                                </a>


                                <a
                                    href="/uploads/resume/<%= resume.file_name %>"
                                    download
                                    class="btn btn-primary mb-2">

                                    <i class="fa-solid fa-download me-1"></i>

                                    Download

                                </a>


                                <form
                                    action="/admin/resume/delete/<%= resume.id %>"
                                    method="POST"
                                    class="d-inline">

                                    <button
                                        type="submit"
                                        class="btn btn-danger mb-2"
                                        onclick="return confirm('Are you sure you want to delete this resume?')">

                                        <i class="fa-solid fa-trash me-1"></i>

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    <% } else { %>

                        <div class="alert alert-warning">

                            <i class="fa-solid fa-triangle-exclamation me-2"></i>

                            No resume has been uploaded yet.

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>