<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Projects | Admin</title>


    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="admin-body">


<!-- ================= SIDEBAR ================= -->

<div class="admin-sidebar">

    <h3>

        <i class="fa-solid fa-user-shield"></i>

        Admin Panel

    </h3>


    <hr>


    <a href="/admin/dashboard">

        <i class="fa-solid fa-gauge"></i>

        Dashboard

    </a>


    <a
        href="/admin/projects"
        class="active"
    >

        <i class="fa-solid fa-code"></i>

        Projects

    </a>


    <a href="/certificates">

        <i class="fa-solid fa-certificate"></i>

        Certificates

    </a>


    <a href="/resume">

        <i class="fa-solid fa-file"></i>

        Resume

    </a>


    <a href="/">

        <i class="fa-solid fa-globe"></i>

        View Portfolio

    </a>


    <a
        href="/admin/logout"
        class="logout-link"
    >

        <i class="fa-solid fa-right-from-bracket"></i>

        Logout

    </a>

</div>


<!-- ================= MAIN ================= -->

<div class="admin-main">


    <div class="admin-topbar">

        <div>

            <h2>
                Manage Projects
            </h2>

            <p>
                Welcome, <strong><%= adminUsername %></strong>
            </p>

        </div>


        <a
            href="/admin/dashboard"
            class="btn btn-outline-primary"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>

    </div>


    <!-- ================= ADD PROJECT ================= -->

    <div class="admin-table-card mb-4">

        <h3 class="mb-4">

            <i class="fa-solid fa-plus"></i>

            Add New Project

        </h3>


        <form
            action="/admin/projects/add"
            method="POST"
        >


            <div class="row">


                <!-- TITLE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Project Name *
                    </label>

                    <input
                        type="text"
                        name="title"
                        class="form-control"
                        placeholder="Enter project name"
                        required
                    >

                </div>


                <!-- IMAGE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Project Image
                    </label>

                    <input
                        type="text"
                        name="image"
                        class="form-control"
                        placeholder="/images/projects/project.jpg"
                    >

                </div>


                <!-- TECHNOLOGIES -->

                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Technologies
                    </label>

                    <input
                        type="text"
                        name="technologies"
                        class="form-control"
                        placeholder="HTML, CSS, JavaScript, Node.js, MySQL"
                    >

                </div>


                <!-- DESCRIPTION -->

                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea
                        name="description"
                        class="form-control"
                        rows="4"
                        placeholder="Describe your project"
                    ></textarea>

                </div>


                <!-- GITHUB -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        GitHub URL
                    </label>

                    <input
                        type="url"
                        name="github_url"
                        class="form-control"
                        placeholder="https://github.com/..."
                    >

                </div>


                <!-- LIVE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Live Website URL
                    </label>

                    <input
                        type="url"
                        name="live_url"
                        class="form-control"
                        placeholder="https://..."
                    >

                </div>


            </div>


            <button
                type="submit"
                class="btn btn-primary"
            >

                <i class="fa-solid fa-plus"></i>

                Add Project

            </button>


        </form>

    </div>


    <!-- ================= EXISTING PROJECTS ================= -->

    <div class="admin-table-card">


        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3>
                Existing Projects
            </h3>


            <span class="badge bg-primary">

                <%= projects.length %> Projects

            </span>

        </div>


        <% if (projects.length === 0) { %>


            <div class="text-center py-5">

                <i
                    class="fa-solid fa-code"
                    style="font-size:50px;"
                ></i>

                <h4 class="mt-3">
                    No projects found
                </h4>

            </div>


        <% } else { %>


            <div class="table-responsive">

                <table class="table table-hover align-middle">


                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Image</th>

                            <th>Project</th>

                            <th>Technologies</th>

                            <th>Links</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>


                        <% projects.forEach(project => { %>


                            <tr>


                                <td>
                                    <%= project.id %>
                                </td>


                                <!-- IMAGE -->

                                <td>

                                    <% if (project.image) { %>

                                        <img
                                            src="/images/projects/<%= project.image %>"
                                            alt="<%= project.title %>"
                                            width="80"
                                            height="60"
                                            style="object-fit:cover;border-radius:8px;"
                                        >

                                    <% } else { %>

                                        <span class="text-muted">
                                            No image
                                        </span>

                                    <% } %>

                                </td>


                                <!-- NAME -->

                                <td>

                                    <strong>
                                        <%= project.title %>
                                    </strong>

                                </td>


                                <!-- TECHNOLOGIES -->

                                <td>

                                    <%= project.technologies || "-" %>

                                </td>


                                <!-- LINKS -->

                                <td>


                                    <% if (project.live_url) { %>

                                        <a
                                            href="<%= project.live_url %>"
                                            target="_blank"
                                            class="btn btn-sm btn-success"
                                        >

                                            <i class="fa-solid fa-globe"></i>

                                        </a>

                                    <% } %>


                                    <% if (project.github_url) { %>

                                        <a
                                            href="<%= project.github_url %>"
                                            target="_blank"
                                            class="btn btn-sm btn-dark"
                                        >

                                            <i class="fa-brands fa-github"></i>

                                        </a>

                                    <% } %>


                                </td>


                                <!-- ACTIONS -->

                                <td>


                                    <button
                                        class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal<%= project.id %>"
                                    >

                                        <i class="fa-solid fa-pen"></i>

                                    </button>


                                    <form
                                        action="/admin/projects/delete/<%= project.id %>"
                                        method="POST"
                                        style="display:inline;"
                                        onsubmit="return confirm('Are you sure you want to delete this project?');"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                        >

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </form>


                                </td>


                            </tr>


                            <!-- ================= EDIT MODAL ================= -->


                            <div
                                class="modal fade"
                                id="editModal<%= project.id %>"
                                tabindex="-1"
                            >

                                <div class="modal-dialog modal-lg">

                                    <div class="modal-content">


                                        <div class="modal-header">

                                            <h5 class="modal-title">

                                                Edit Project

                                            </h5>


                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                            ></button>

                                        </div>


                                        <form
                                            action="/admin/projects/edit/<%= project.id %>"
                                            method="POST"
                                        >


                                            <div class="modal-body">


                                                <div class="mb-3">

                                                    <label class="form-label">
                                                        Project Name
                                                    </label>

                                                    <input
                                                        type="text"
                                                        name="title"
                                                        class="form-control"
                                                        value="<%= project.title %>"
                                                        required
                                                    >

                                                </div>


                                                <div class="mb-3">

                                                    <label class="form-label">
                                                        Image
                                                    </label>

                                                    <input
                                                        type="text"
                                                        name="image"
                                                        class="form-control"
                                                        value="<%= project.image || '' %>"
                                                    >

                                                </div>


                                                <div class="mb-3">

                                                    <label class="form-label">
                                                        Technologies
                                                    </label>

                                                    <input
                                                        type="text"
                                                        name="technologies"
                                                        class="form-control"
                                                        value="<%= project.technologies || '' %>"
                                                    >

                                                </div>


                                                <div class="mb-3">

                                                    <label class="form-label">
                                                        Description
                                                    </label>

                                                    <textarea
                                                        name="description"
                                                        class="form-control"
                                                        rows="4"
                                                    ><%= project.description || '' %></textarea>

                                                </div>


                                                <div class="row">


                                                    <div class="col-md-6">

                                                        <label class="form-label">
                                                            GitHub URL
                                                        </label>

                                                        <input
                                                            type="url"
                                                            name="github_url"
                                                            class="form-control"
                                                            value="<%= project.github_url || '' %>"
                                                        >

                                                    </div>


                                                    <div class="col-md-6">

                                                        <label class="form-label">
                                                            Live Website URL
                                                        </label>

                                                        <input
                                                            type="url"
                                                            name="live_url"
                                                            class="form-control"
                                                            value="<%= project.live_url || '' %>"
                                                        >

                                                    </div>


                                                </div>


                                            </div>


                                            <div class="modal-footer">

                                                <button
                                                    type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal"
                                                >
                                                    Cancel
                                                </button>


                                                <button
                                                    type="submit"
                                                    class="btn btn-primary"
                                                >

                                                    <i class="fa-solid fa-save"></i>

                                                    Save Changes

                                                </button>

                                            </div>


                                        </form>


                                    </div>

                                </div>

                            </div>


                        <% }) %>


                    </tbody>

                </table>

            </div>


        <% } %>


    </div>


</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


</body>

</html>