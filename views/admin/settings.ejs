<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Admin Settings</title>

    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


    <style>

        body {
            background: #f5f7fb;
        }

        .sidebar {
            min-height: 100vh;
        }

        .settings-card {
            border: none;
            border-radius: 15px;
        }

        .settings-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
        }

        @media (max-width: 768px) {

            .sidebar {
                min-height: auto;
            }

        }

    </style>

</head>


<body>

<div class="container-fluid">

    <div class="row">


        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <div class="col-md-3 col-lg-2 bg-dark text-white p-3 sidebar">


            <h3 class="text-center mb-4">

                <i class="fa-solid fa-user-shield"></i>

                Admin Panel

            </h3>


            <hr>


            <div class="text-center mb-4">

                <i class="fa-solid fa-circle-user fa-3x"></i>

                <p class="mt-2 mb-0">
                    Welcome
                </p>

                <strong>
                    <%= admin.username %>
                </strong>

            </div>


            <ul class="nav flex-column">


                <li class="nav-item">

                    <a
                        href="/admin/dashboard"
                        class="nav-link text-white">

                        <i class="fa-solid fa-house me-2"></i>

                        Dashboard

                    </a>

                </li>


                <li class="nav-item">

                    <a
                        href="/admin/projects"
                        class="nav-link text-white">

                        <i class="fa-solid fa-code me-2"></i>

                        Projects

                    </a>

                </li>


                <li class="nav-item">

                    <a
                        href="/admin/certificates"
                        class="nav-link text-white">

                        <i class="fa-solid fa-certificate me-2"></i>

                        Certificates

                    </a>

                </li>


                <li class="nav-item">

                    <a
                        href="/admin/resume"
                        class="nav-link text-white">

                        <i class="fa-solid fa-file-pdf me-2"></i>

                        Resume

                    </a>

                </li>


                <li class="nav-item">

                    <a
                        href="/admin/messages"
                        class="nav-link text-white">

                        <i class="fa-solid fa-envelope me-2"></i>

                        Messages

                    </a>

                </li>


                <li class="nav-item">

                    <a
                        href="/admin/settings"
                        class="nav-link text-white bg-primary rounded">

                        <i class="fa-solid fa-gear me-2"></i>

                        Settings

                    </a>

                </li>


            </ul>


            <hr>


            <a
                href="/admin/logout"
                class="btn btn-danger w-100">

                <i class="fa-solid fa-right-from-bracket me-2"></i>

                Logout

            </a>

        </div>



        <!-- ========================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================= -->

        <div class="col-md-9 col-lg-10 p-4">


            <div class="mb-4">

                <h2 class="fw-bold">

                    <i class="fa-solid fa-gear me-2"></i>

                    Admin Settings

                </h2>

                <p class="text-muted">

                    Manage your administrator account.

                </p>

            </div>



            <!-- SUCCESS MESSAGE -->

            <% if (typeof success !== 'undefined' && success) { %>

                <div
                    class="alert alert-success alert-dismissible fade show">

                    <i class="fa-solid fa-circle-check me-2"></i>

                    <%= success %>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                    </button>

                </div>

            <% } %>



            <!-- ERROR MESSAGE -->

            <% if (typeof error !== 'undefined' && error) { %>

                <div
                    class="alert alert-danger alert-dismissible fade show">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    <%= error %>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                    </button>

                </div>

            <% } %>



            <div class="row g-4">


                <!-- PROFILE -->

                <div class="col-lg-5">

                    <div class="card settings-card shadow-sm">

                        <div class="card-body p-4">


                            <div class="d-flex align-items-center mb-4">

                                <div class="settings-icon bg-primary text-white me-3">

                                    <i class="fa-solid fa-user"></i>

                                </div>

                                <div>

                                    <h4 class="mb-0">

                                        Admin Profile

                                    </h4>

                                    <small class="text-muted">

                                        Account information

                                    </small>

                                </div>

                            </div>


                            <div class="mb-3">

                                <label class="form-label fw-bold">

                                    Username

                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    value="<%= admin.username %>"
                                    disabled>

                            </div>


                            <div class="mb-3">

                                <label class="form-label fw-bold">

                                    Account Type

                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    value="Administrator"
                                    disabled>

                            </div>


                            <div class="alert alert-info">

                                <i class="fa-solid fa-shield-halved me-2"></i>

                                Your administrator password is securely
                                stored using bcrypt hashing.

                            </div>

                        </div>

                    </div>

                </div>



                <!-- CHANGE USERNAME -->

                <div class="col-lg-7">

                    <div class="card settings-card shadow-sm mb-4">

                        <div class="card-body p-4">


                            <h4 class="mb-4">

                                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>

                                Change Username

                            </h4>


                            <form
                                action="/admin/settings/username"
                                method="POST">


                                <div class="mb-3">

                                    <label class="form-label">

                                        New Username

                                    </label>

                                    <input
                                        type="text"
                                        name="username"
                                        class="form-control"
                                        minlength="3"
                                        maxlength="50"
                                        value="<%= admin.username %>"
                                        required>

                                </div>


                                <button
                                    type="submit"
                                    class="btn btn-primary">

                                    <i class="fa-solid fa-save me-2"></i>

                                    Update Username

                                </button>


                            </form>

                        </div>

                    </div>



                    <!-- CHANGE PASSWORD -->

                    <div class="card settings-card shadow-sm">

                        <div class="card-body p-4">


                            <h4 class="mb-4">

                                <i class="fa-solid fa-lock text-danger me-2"></i>

                                Change Password

                            </h4>


                            <form
                                action="/admin/settings/password"
                                method="POST"
                                id="passwordForm">


                                <div class="mb-3">

                                    <label class="form-label">

                                        Current Password

                                    </label>

                                    <input
                                        type="password"
                                        name="currentPassword"
                                        id="currentPassword"
                                        class="form-control"
                                        required>

                                </div>


                                <div class="mb-3">

                                    <label class="form-label">

                                        New Password

                                    </label>

                                    <input
                                        type="password"
                                        name="newPassword"
                                        id="newPassword"
                                        class="form-control"
                                        minlength="6"
                                        required>

                                    <small class="text-muted">

                                        Minimum 6 characters.

                                    </small>

                                </div>


                                <div class="mb-3">

                                    <label class="form-label">

                                        Confirm New Password

                                    </label>

                                    <input
                                        type="password"
                                        name="confirmPassword"
                                        id="confirmPassword"
                                        class="form-control"
                                        minlength="6"
                                        required>

                                </div>


                                <button
                                    type="submit"
                                    class="btn btn-danger">

                                    <i class="fa-solid fa-key me-2"></i>

                                    Change Password

                                </button>


                            </form>

                        </div>

                    </div>

                </div>

            </div>


        </div>

    </div>

</div>



<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

document
    .getElementById("passwordForm")
    .addEventListener("submit", function(event) {

        const newPassword =
            document.getElementById("newPassword").value;

        const confirmPassword =
            document.getElementById("confirmPassword").value;


        if (newPassword !== confirmPassword) {

            event.preventDefault();

            alert("New password and confirm password do not match.");

        }

    });

</script>


</body>

</html>