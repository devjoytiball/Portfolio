<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/admin/dashboard">

            <i class="fa-solid fa-gauge"></i>

            Admin Panel

        </a>

        <span class="text-white">

            Welcome, <%= adminUsername %>

        </span>

    </div>

</nav>


<div class="container py-5">

    <h2 class="mb-4">

        Admin Dashboard

    </h2>


    <div class="row g-4">


        <!-- Projects -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-code fa-2x mb-3"></i>

                    <h5>Projects</h5>

                    <h2><%= projectCount %></h2>

                    <a href="/admin/projects"
                       class="btn btn-primary">

                        Manage

                    </a>

                </div>

            </div>

        </div>


        <!-- Certificates -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-certificate fa-2x mb-3"></i>

                    <h5>Certificates</h5>

                    <h2><%= certificateCount %></h2>

                    <a href="/admin/certificates"
                       class="btn btn-success">

                        Manage

                    </a>

                </div>

            </div>

        </div>


        <!-- Messages -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-envelope fa-2x mb-3"></i>

                    <h5>Messages</h5>

                    <h2><%= messageCount %></h2>

                    <a href="/admin/messages"
                       class="btn btn-warning">

                        View

                    </a>

                </div>

            </div>

        </div>


        <!-- Resume -->

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="fa-solid fa-file-pdf fa-2x mb-3"></i>

                    <h5>Resume</h5>

                    <h2><%= resumeCount %></h2>

                    <a href="/admin/resume"
                       class="btn btn-danger">

                        Manage

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Quick Actions -->

    <div class="card mt-5 shadow-sm border-0">

        <div class="card-body">

            <h4 class="mb-4">
                Quick Actions
            </h4>

            <div class="d-flex flex-wrap gap-2">

                <a href="/admin/projects"
                   class="btn btn-primary">

                    <i class="fa-solid fa-plus"></i>
                    Projects

                </a>

                <a href="/admin/certificates"
                   class="btn btn-success">

                    <i class="fa-solid fa-plus"></i>
                    Certificates

                </a>

                <a href="/admin/resume"
                   class="btn btn-danger">

                    <i class="fa-solid fa-upload"></i>
                    Resume

                </a>

                <a href="/admin/messages"
                   class="btn btn-warning">

                    <i class="fa-solid fa-envelope"></i>
                    Messages

                </a>

                <a href="/admin/settings"
                   class="btn btn-secondary">

                    <i class="fa-solid fa-gear"></i>
                    Settings

                </a>

                <a href="/admin/logout"
                   class="btn btn-dark">

                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout

                </a>

            </div>

        </div>

    </div>

</div>

</body>

</html>