<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Certificates | Admin</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- Main CSS -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="admin-body">


<!-- =========================
     SIDEBAR
========================= -->

<div class="admin-sidebar">


    <h3>

        <i class="fa-solid fa-user-shield"></i>

        Admin Panel

    </h3>


    <hr>


    <a href="/admin/dashboard">

        <i class="fa-solid fa-gauge"></i>

        Dashboard

    </a>


    <a href="/admin/projects">

        <i class="fa-solid fa-code"></i>

        Projects

    </a>


    <a
        href="/admin/certificates"
        class="active"
    >

        <i class="fa-solid fa-certificate"></i>

        Certificates

    </a>


    <a href="/resume">

        <i class="fa-solid fa-file"></i>

        Resume

    </a>


    <a href="/">

        <i class="fa-solid fa-globe"></i>

        View Portfolio

    </a>


    <a
        href="/admin/logout"
        class="logout-link"
    >

        <i class="fa-solid fa-right-from-bracket"></i>

        Logout

    </a>


</div>



<!-- =========================
     MAIN CONTENT
========================= -->

<div class="admin-main">


    <!-- TOP BAR -->

    <div class="admin-topbar">


        <div>

            <h2>
                Manage Certificates
            </h2>

            <p>

                Welcome,
                <strong>
                    <%= adminUsername %>
                </strong>

            </p>

        </div>


        <a
            href="/admin/dashboard"
            class="btn btn-outline-primary"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>


    </div>



    <!-- =========================
         ADD CERTIFICATE
    ========================= -->

    <div class="admin-table-card mb-4">


        <h3 class="mb-4">

            <i class="fa-solid fa-plus"></i>

            Add New Certificate

        </h3>


        <form
            action="/admin/certificates/add"
            method="POST"
        >


            <div class="row">


                <!-- TITLE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Certificate Name *

                    </label>


                    <input
                        type="text"
                        name="title"
                        class="form-control"
                        placeholder="Enter certificate name"
                        required
                    >

                </div>



                <!-- ISSUER -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Issued By

                    </label>


                    <input
                        type="text"
                        name="issuer"
                        class="form-control"
                        placeholder="Example: Coursera, AWS, Google"
                    >

                </div>



                <!-- ISSUE DATE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Issue Date

                    </label>


                    <input
                        type="text"
                        name="issue_date"
                        class="form-control"
                        placeholder="Example: August 2026"
                    >

                </div>



                <!-- IMAGE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Certificate Image

                    </label>


                    <input
                        type="text"
                        name="certificate_image"
                        class="form-control"
                        placeholder="/images/certificates/certificate1.jpg"
                    >

                </div>



                <!-- DESCRIPTION -->

                <div class="col-md-12 mb-3">

                    <label class="form-label">

                        Description

                    </label>


                    <textarea
                        name="description"
                        class="form-control"
                        rows="4"
                        placeholder="Certificate description"
                    ></textarea>

                </div>



               


            </div>



            <button
                type="submit"
                class="btn btn-primary"
            >

                <i class="fa-solid fa-plus"></i>

                Add Certificate

            </button>


        </form>


    </div>



    <!-- =========================
         EXISTING CERTIFICATES
    ========================= -->

    <div class="admin-table-card">


        <div
            class="d-flex justify-content-between align-items-center mb-4"
        >


            <h3>

                Existing Certificates

            </h3>


            <span class="badge bg-primary">

                <%= certificates.length %>
                Certificates

            </span>


        </div>



        <% if (certificates.length === 0) { %>


            <div class="text-center py-5">


                <i
                    class="fa-solid fa-certificate"
                    style="font-size:50px;"
                ></i>


                <h4 class="mt-3">

                    No certificates found

                </h4>


                <p class="text-muted">

                    Add your first certificate above.

                </p>


            </div>


        <% } else { %>



            <div class="table-responsive">


                <table
                    class="table table-hover align-middle"
                >


                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Image</th>

                            <th>Certificate</th>

                            <th>Issuer</th>

                            <th>Date</th>

                            <th>Link</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>


                        <% certificates.forEach(certificate => { %>


                            <tr>


                                <!-- ID -->

                                <td>

                                    <%= certificate.id %>

                                </td>



                                <!-- IMAGE -->

                                <td>


                                    <% if (
                                        certificate.certificate_file
                                    ) { %>

                                        <img
                                            src="/certificates/<%= certificate.certificate_file %>"
                                            alt="<%= certificate.title %>"
                                            width="90"
                                            height="65"
                                            style="
                                                object-fit:cover;
                                                border-radius:8px;
                                            "
                                        >
                                    

                                    <% } else { %>


                                        <span class="text-muted">

                                            No image

                                        </span>


                                    <% } %>


                                </td>



                                <!-- TITLE -->

                                <td>

                                    <strong>

                                        <%= certificate.title %>

                                    </strong>


                                    <% if (
                                        certificate.description
                                    ) { %>

                                        <br>

                                        <small
                                            class="text-muted"
                                        >

                                            <%= certificate.description %>

                                        </small>

                                    <% } %>


                                </td>



                                <!-- ISSUER -->

                                <td>

                                    <%= certificate.issuer || "-" %>

                                </td>



                                <!-- DATE -->

                                <td>

                                    <%= certificate.issue_date || "-" %>

                                </td>



                                <!-- URL -->

                                <td>


                                    <% if (
                                        certificate.certificate_url
                                    ) { %>


                                        <a
                                            href="<%= certificate.certificate_url %>"
                                            target="_blank"
                                            class="btn btn-sm btn-success"
                                        >

                                            <i
                                                class="fa-solid fa-eye"
                                            ></i>

                                        </a>


                                    <% } else { %>


                                        -

                                    <% } %>


                                </td>



                                <!-- ACTIONS -->

                                <td>


                                    <button
                                        class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editCertificate<%= certificate.id %>"
                                    >

                                        <i
                                            class="fa-solid fa-pen"
                                        ></i>

                                    </button>



                                    <form
                                        action="/admin/certificates/delete/<%= certificate.id %>"
                                        method="POST"
                                        style="display:inline;"
                                        onsubmit="return confirm('Are you sure you want to delete this certificate?');"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                        >

                                            <i
                                                class="fa-solid fa-trash"
                                            ></i>

                                        </button>

                                    </form>


                                </td>


                            </tr>



                            <!-- =========================
                                 EDIT MODAL
                            ========================= -->


                            <div
                                class="modal fade"
                                id="editCertificate<%= certificate.id %>"
                                tabindex="-1"
                            >


                                <div
                                    class="modal-dialog modal-lg"
                                >


                                    <div class="modal-content">


                                        <div class="modal-header">


                                            <h5 class="modal-title">

                                                Edit Certificate

                                            </h5>


                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                            ></button>


                                        </div>



                                        <form
                                            action="/admin/certificates/edit/<%= certificate.id %>"
                                            method="POST"
                                        >


                                            <div class="modal-body">


                                                <!-- TITLE -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Certificate Name

                                                    </label>


                                                    <input
                                                        type="text"
                                                        name="title"
                                                        class="form-control"
                                                        value="<%= certificate.title %>"
                                                        required
                                                    >

                                                </div>



                                                <!-- ISSUER -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Issued By

                                                    </label>


                                                    <input
                                                        type="text"
                                                        name="issuer"
                                                        class="form-control"
                                                        value="<%= certificate.issuer || '' %>"
                                                    >

                                                </div>



                                                <!-- DATE -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Issue Date

                                                    </label>


                                                    <input
                                                        type="text"
                                                        name="issue_date"
                                                        class="form-control"
                                                        value="<%= certificate.issue_date || '' %>"
                                                    >

                                                </div>



                                                <!-- IMAGE -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Certificate Image

                                                    </label>


                                                    <input
                                                        type="text"
                                                        name="certificate_image"
                                                        class="form-control"
                                                        value="<%= certificate.certificate_image || '' %>"
                                                    >

                                                </div>



                                                <!-- DESCRIPTION -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Description

                                                    </label>


                                                    <textarea
                                                        name="description"
                                                        class="form-control"
                                                        rows="4"
                                                    ><%= certificate.description || '' %></textarea>

                                                </div>



                                                <!-- URL -->

                                                <div class="mb-3">

                                                    <label class="form-label">

                                                        Verification URL

                                                    </label>


                                                    <input
                                                        type="url"
                                                        name="certificate_url"
                                                        class="form-control"
                                                        value="<%= certificate.certificate_url || '' %>"
                                                    >

                                                </div>


                                            </div>



                                            <div class="modal-footer">


                                                <button
                                                    type="button"
                                                    class="btn btn-secondary"
                                                    data-bs-dismiss="modal"
                                                >

                                                    Cancel

                                                </button>


                                                <button
                                                    type="submit"
                                                    class="btn btn-primary"
                                                >

                                                    <i
                                                        class="fa-solid fa-save"
                                                    ></i>

                                                    Save Changes

                                                </button>


                                            </div>


                                        </form>


                                    </div>


                                </div>


                            </div>


                        <% }) %>


                    </tbody>


                </table>


            </div>


        <% } %>


    </div>


</div>



<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>


</body>

</html>